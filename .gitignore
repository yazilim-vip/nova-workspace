# Cloned repositories — preserve root folder only, contents fully local
git-repositories/*
!git-repositories/.gitkeep

# Agent-generated scripts
scripts/

# Task management (per-developer state)
tasks.md
.tasks/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Tool adapters (platform-specific, local only)
.claude/
.github/copilot-instructions.md
.kiro/
.cursor/
.windsurfrules

# Workspace instance (per-developer, fully local — generated by onboarding from .ai/onboarding/assets/)
.ai/workspace/

# Personal notes vault (per-machine, not shared — see .ai/personal-knowledge-management/README.md).
# Leading slash anchors to workspace root.
/notes/
