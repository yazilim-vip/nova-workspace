<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template: .idea/modules.xml
  Lists every module in the project. One <module> element per .iml file.

  Placeholders:
    {{MODULES}} — newline-joined list of <module fileurl="..." filepath="..." group="..." /> entries.

  Example of a rendered <module> entry (with group path for the Project tool window tree):
    <module fileurl="file://$PROJECT_DIR$/.idea/modules/gym-tracker.iml"
            filepath="$PROJECT_DIR$/.idea/modules/gym-tracker.iml"
            group="github/yazilim-vip" />

  Workspace-root module omits the group attribute so it lives at the root of the tree:
    <module fileurl="file://$PROJECT_DIR$/.idea/modules/yazilim-vip-workspace.iml"
            filepath="$PROJECT_DIR$/.idea/modules/yazilim-vip-workspace.iml" />
-->
<project version="4">
  <component name="ProjectModuleManager">
    <modules>
{{MODULES}}
    </modules>
  </component>
</project>
